{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dYT",
  "mainBinaryName": "dyt",
  "version": "../package.json",
  "identifier": "io.github.dixonsolutions.dyt",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dYT",
        "width": 980,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: https://*.ytimg.com https://*.ggpht.com",
        "media-src": "'self' blob: https://*.googlevideo.com",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Video",
    "shortDescription": "Fast, reliable YouTube downloads",
    "longDescription": "Download YouTube videos, audio or exact clips with a native Rust engine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": { "depends": ["ffmpeg"] },
      "rpm": { "depends": ["ffmpeg"] }
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
